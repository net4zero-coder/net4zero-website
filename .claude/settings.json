{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//home/user/net4zero-website/**)",
      "Glob(//home/user/net4zero-website/**)",
      "Grep(//home/user/net4zero-website/**)",
      "Bash(python3 tools/check-site.py:*)",
      "Bash(tools/build-css.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(npx --yes tailwindcss@3.4.19:*)",
      "WebFetch(domain:www.net4zero.pl)",
      "WebFetch(domain:isap.sejm.gov.pl)",
      "WebFetch(domain:search.google.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 tools/check-site.py --quiet 2>&1 | head -40",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
