# ─────────────────────────────────────────────────────────────
# GeoCRM — zmienne środowiskowe (skopiuj do .env / .env.local)
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Supabase / Neon / lokalny). Pooler URL do runtime, direct do migracji.
DATABASE_URL="postgresql://user:password@localhost:5432/geocrm?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/geocrm?schema=public"

# Auth.js v5 — wygeneruj: `openssl rand -base64 32`
AUTH_SECRET="zmien-mnie-na-losowy-sekret"
# Bazowy URL aplikacji (produkcja: https://crm.net4zero.pl)
AUTH_URL="http://localhost:3000"

# Google Maps — klucz z włączonymi: Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map ID (Cloud-based styling; wymagane dla AdvancedMarker)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# Storage (Supabase Storage lub AWS S3) — moduł dokumentów (Etap 11)
STORAGE_PROVIDER="supabase"           # supabase | s3
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="geocrm-documents"
# AWS S3 (alternatywa)
AWS_REGION="eu-central-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Powiadomienia e-mail (opcjonalnie, moduł zadań — Etap 12)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="GeoCRM <no-reply@net4zero.pl>"
