// ─────────────────────────────────────────────────────────────────────────────
// GeoCRM — schemat bazy danych (Prisma)
//
// Domena: zarządzanie lokalizacjami recyklomatów (automatów kaucyjnych) NET4ZERO,
// inwestorami, operatorami, handlowcami i regionami sprzedaży.
//
// Zasady projektowe:
//  • Multi-tenant SaaS — wszystkie encje domenowe są scope'owane do Organization.
//  • Pełna historia zmian lokalizacji (LocationHistory) + feed aktywności (Activity).
//  • Zgodność z Auth.js v5 (User / Account / Session / VerificationToken).
//  • Geometria regionów przechowywana jako GeoJSON (Json) — gotowe pod rysowanie
//    obszarów na mapie Google (Drawing/Geometry library).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  ENUMY
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  ADMIN // Administrator — pełny dostęp
  MANAGER // Manager — zarządza regionami, handlowcami, raportami
  SALES // Handlowiec — swoje regiony/lokalizacje/zadania
  INVESTOR // Inwestor — podgląd swojego portfela
  SERVICE // Serwisant — instalacje, serwis urządzeń
}

enum LocationStatus {
  SIGNED // zielony  — podpisana
  NEGOTIATION // żółty    — negocjacje
  INSTALLATION // niebieski — instalacja
  REJECTED // czerwony — odrzucona
  FREE // szary    — wolna lokalizacja
}

enum LocationType {
  OSIEDLE
  SKLEP
  GALERIA
  URZAD
  PARKING
  INNE
}

enum RegionType {
  WOJEWODZTWO
  POWIAT
  MIASTO
  CUSTOM // własny obszar narysowany na mapie
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentCategory {
  PDF
  WORD
  EXCEL
  IMAGE
  OTHER
}

enum DeviceStatus {
  PLANNED
  INSTALLED
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  TERMINATED
}

// ═══════════════════════════════════════════════════════════════════════════
//  TENANT / ORGANIZACJA
// ═══════════════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  regions    Region[]
  locations  Location[]
  investors  Investor[]
  operators  Operator[]
  tasks      Task[]
  documents  Document[]
  devices    Device[]
  contracts  Contract[]
  activities Activity[]
}

// ═══════════════════════════════════════════════════════════════════════════
//  AUTORYZACJA (Auth.js v5) + RBAC
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials provider (bcrypt)
  role          Role      @default(SALES)
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Domena
  managedRegions    Region[]          @relation("RegionAgent")
  ownedLocations    Location[]        @relation("LocationAgent")
  createdLocations  Location[]        @relation("LocationCreatedBy")
  investorProfile   Investor?         @relation("InvestorUser")
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreatedBy")
  uploadedDocuments Document[]        @relation("DocumentUploadedBy")
  notes             Note[]
  activities        Activity[]
  locationHistory   LocationHistory[]
  salesGoals        SalesGoal[]
  calendarEvents    CalendarEvent[]

  @@index([organizationId])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  token   String   @unique
  userId  String
  expires DateTime
  used    Boolean  @default(false)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  REGIONY
// ═══════════════════════════════════════════════════════════════════════════

model Region {
  id          String     @id @default(cuid())
  name        String
  type        RegionType @default(CUSTOM)
  // GeoJSON Polygon/MultiPolygon dla obszarów CUSTOM rysowanych na mapie,
  // lub kod TERYT/nazwa dla województw/powiatów/miast.
  geometry    Json?
  terytCode   String?
  color       String? // kolor obrysu na mapie (hex)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // przypisany handlowiec
  agentId String?
  agent   User?   @relation("RegionAgent", fields: [agentId], references: [id], onDelete: SetNull)

  // przypisany inwestor
  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  locations Location[]

  @@index([organizationId])
  @@index([agentId])
  @@index([investorId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  INWESTORZY / OPERATORZY
// ═══════════════════════════════════════════════════════════════════════════

model Investor {
  id            String   @id @default(cuid())
  name          String
  nip           String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // opcjonalne konto logowania (rola INVESTOR)
  userId String? @unique
  user   User?   @relation("InvestorUser", fields: [userId], references: [id], onDelete: SetNull)

  locations Location[]
  regions   Region[]
  contracts Contract[]
  devices   Device[]

  @@index([organizationId])
}

model Operator {
  id            String   @id @default(cuid())
  name          String
  nip           String?
  contactPerson String?
  email         String?
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locations Location[]
  devices   Device[]

  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  LOKALIZACJE (rdzeń systemu)
// ═══════════════════════════════════════════════════════════════════════════

model Location {
  id          String         @id @default(cuid())
  name        String
  address     String?
  city        String?
  voivodeship String?
  postalCode  String?
  latitude    Float
  longitude   Float
  status      LocationStatus @default(FREE)
  type        LocationType   @default(INNE)
  description String?

  // kontakt (kontakt główny; dodatkowe w modelu Contact)
  contactName  String?
  contactPhone String?
  contactEmail String?
  ownerName    String? // właściciel terenu/nieruchomości

  // parametry biznesowe
  plannedInstall   DateTime?
  launchedAt       DateTime?
  roi              Float? // zwrot z inwestycji (%)
  forecastPackages Int? // prognoza liczby opakowań / miesiąc
  deviceNumber     String? // numer urządzenia (jeśli 1:1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  agentId String?
  agent   User?   @relation("LocationAgent", fields: [agentId], references: [id], onDelete: SetNull)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("LocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  contacts  Contact[]
  notes     Note[]
  photos    Photo[]
  documents Document[]
  tasks     Task[]
  devices   Device[]
  contracts Contract[]
  history   LocationHistory[]

  @@index([organizationId])
  @@index([status])
  @@index([regionId])
  @@index([agentId])
  @@index([investorId])
  @@index([operatorId])
  @@index([latitude, longitude])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([locationId])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

// Historia zmian pól lokalizacji ("każda zmiana zapisuje historię")
model LocationHistory {
  id        String   @id @default(cuid())
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([locationId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  URZĄDZENIA / UMOWY
// ═══════════════════════════════════════════════════════════════════════════

model Device {
  id            String       @id @default(cuid())
  serialNumber  String
  model         String?
  status        DeviceStatus @default(PLANNED)
  installedAt   DateTime?
  lastServiceAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([locationId])
  @@index([status])
}

model Contract {
  id        String         @id @default(cuid())
  title     String
  status    ContractStatus @default(DRAFT)
  signedAt  DateTime?
  expiresAt DateTime?
  value     Float?
  fileUrl   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
//  DOKUMENTY / ZADANIA / KALENDARZ / CELE
// ═══════════════════════════════════════════════════════════════════════════

model Document {
  id        String           @id @default(cuid())
  name      String
  category  DocumentCategory @default(OTHER)
  url       String
  sizeBytes Int?
  mimeType  String?
  createdAt DateTime         @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([locationId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assigneeId])
  @@index([status])
}

model CalendarEvent {
  id        String    @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  notes     String?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cele sprzedażowe handlowca (ranking / statystyki)
model SalesGoal {
  id        String   @id @default(cuid())
  period    String // np. "2026-Q3" lub "2026-07"
  target    Int // cel (np. liczba podpisanych lokalizacji)
  achieved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  FEED AKTYWNOŚCI (dashboard "ostatnie aktywności")
// ═══════════════════════════════════════════════════════════════════════════

model Activity {
  id         String   @id @default(cuid())
  type       String // np. LOCATION_CREATED, STATUS_CHANGED, TASK_DONE
  message    String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}
